# ─── Database ────────────────────────────────────────────────────────────────
# Local dev: `npm run db` starts PGlite (PostgreSQL 18 + PostGIS, WASM) on 54329.
# Production: the Supabase Postgres connection string (Settings → Database →
# Connection pooling, "Session" mode). Never expose this to the browser.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres

# ─── Server secrets (never NEXT_PUBLIC_) ───────────────────────────────────
# Signs account session cookies. Use a long random string (openssl rand -base64 32).
# Staff accounts are created with `npm run account -- create <email> --role admin`.
SESSION_SECRET=change-me-session-secret
# Bearer token for scripted access to /api/admin/* and /api/ops/* (no UI login).
ADMIN_TOKEN=change-me-admin-token
# Shared secret Supabase Cron / any scheduler sends as `Authorization: Bearer`.
CRON_SECRET=change-me-cron-secret
# Optional: Claude for ambiguous extraction + answer phrasing. Without it the
# system runs deterministic-only (it never needs an LLM to be correct).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Optional: Gemini runs the /ask assistant when ANTHROPIC_API_KEY is not set.
# GEMINI_MODEL is an ordered, comma-separated failover list; GEMINI_THINKING low|medium|high.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-3-flash-preview
GEMINI_THINKING=low
# Optional: 2GIS Places / routing (demo key works for hackathons).
DGIS_API_KEY=
# Optional: data.egov.kz open data API key.
EGOV_API_KEY=

# ─── Behaviour ───────────────────────────────────────────────────────────────
# DEMO_MODE=true enables /admin demo scenario injection. Demo events are always
# stored with is_demo=true and labelled in every surface.
DEMO_MODE=true
# Weather/marine/air connectors are scheduled; this toggles the in-process
# scheduler used in local dev (production uses Supabase Cron → /api/cron/*).
LOCAL_SCHEDULER=true
# Live demo: the address phones use to join (/live/{code}) when it is not the
# address the presenter opened (e.g. a tunnel). Empty: the presenter's host,
# or this laptop's LAN address when the presenter uses localhost.
PUBLIC_BASE_URL=
# Contact string sent in User-Agent to public APIs (OSM policies require it).
CONTACT_UA="AktauCityApp/0.1 (+https://github.com/aktau-city; hackathon)"

# ─── Public (safe to expose) ─────────────────────────────────────────────────
# Map style. Default: OSM raster tiles via an inline style (with attribution).
# Swap for MapTiler / 2GIS / self-hosted without touching map code.
NEXT_PUBLIC_MAP_STYLE_URL=
